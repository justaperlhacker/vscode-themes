  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#d2d4db",
    "variable.readonly": "#a6e5c3",
    "property": "#f6cc9b",
    "function": "#93e4ee",
    "class": "#d2d4db",
    "struct": "#d2d4db",
    "interface": "#d2d4db",
    "enum": "#d2d4db",
    "enumMember": "#d2d4db",
    "type": "#d2d4db",
    "typeParameter": "#d2d4db",
    "keyword": {
      "foreground": "#d2d4db",
      "bold": true
    },
    "modifier": {
      "foreground": "#d2d4db",
      "bold": true
    },
    "comment": "#93949b",
    "string": "#d1db9f",
    "number": "#d8caff",
    "regexp": "#a6e5c3",
    "operator": "#d2d4db",
    "decorator": "#acd6ff",
    "label": {
      "foreground": "#d2d4db",
      "bold": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#93949b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#93949b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#d1db9f"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "string.special.symbol"
      ],
      "settings": {
        "foreground": "#d8caff"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#d1db9f"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d8caff"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d8caff"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d8caff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#f6cc9b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#93e4ee"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d2d4db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#d2d4db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#f6cc9b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "support.class"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "entity.name.enum",
        "support.type.enum"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "entity.name.enum.variant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#acd6ff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#f6cc9b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ffc1b9"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ffc1b9"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#ffc1b9"
      }
    },
    {
      "scope": [
        "punctuation.special"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "punctuation.list_marker",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#a6e5c3"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#f6cc9b"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d2d4db",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d2d4db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    }
  ]
}
