  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#121113",
    "variable.readonly": "#e24744",
    "property": "#bd2723",
    "function": "#a04b14",
    "class": "#795f00",
    "struct": "#795f00",
    "interface": "#795f00",
    "enum": "#d17b48",
    "enumMember": "#a04b14",
    "type": "#795f00",
    "typeParameter": "#795f00",
    "keyword": {
      "foreground": "#e78a53",
      "italic": true
    },
    "modifier": {
      "foreground": "#e78a53",
      "italic": true
    },
    "comment": {
      "foreground": "#b4b1b0",
      "italic": true
    },
    "string": "#007400",
    "number": "#e24744",
    "regexp": "#009300",
    "operator": "#d17b48",
    "decorator": "#a04b14",
    "label": "#a04b14"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b4b1b0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#b4b1b0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#007400"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#d17b48"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#009300"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#d17b48"
      }
    },
    {
      "scope": [
