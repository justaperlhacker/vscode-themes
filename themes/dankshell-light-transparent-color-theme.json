    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e78a53",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.label"
