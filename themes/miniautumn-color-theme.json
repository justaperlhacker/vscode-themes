  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#d7d5cd",
    "variable.readonly": "#b4e2c7",
    "property": "#efcfab",
    "function": "#a7e1e8",
    "class": "#d7d5cd",
    "struct": "#d7d5cd",
    "interface": "#d7d5cd",
    "enum": "#d7d5cd",
    "enumMember": "#d7d5cd",
    "type": "#d7d5cd",
    "typeParameter": "#d7d5cd",
    "keyword": {
      "foreground": "#d7d5cd",
      "bold": true
    },
    "modifier": {
      "foreground": "#d7d5cd",
      "bold": true
    },
    "comment": {
      "foreground": "#97958e",
      "italic": true
    },
    "string": "#d3daad",
    "number": "#d7cef9",
    "regexp": "#b4e2c7",
    "operator": "#d7d5cd",
    "decorator": "#b8d9fc",
    "label": {
      "foreground": "#d7d5cd",
      "bold": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#97958e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#97958e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#d3daad"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "string.special.symbol"
      ],
      "settings": {
        "foreground": "#d7cef9"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#d3daad"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d7cef9"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d7cef9"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d7cef9"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#efcfab"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#a7e1e8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d7d5cd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#d7d5cd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#e4caf1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "support.class"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "entity.name.enum",
        "support.type.enum"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "entity.name.enum.variant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#b8d9fc"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#efcfab"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#fac6c1"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#fac6c1"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#fac6c1"
      }
    },
    {
      "scope": [
        "punctuation.special"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "punctuation.list_marker",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#b4e2c7"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#efcfab"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d7d5cd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d7d5cd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#d7d5cd"
      }
    }
  ]
}
