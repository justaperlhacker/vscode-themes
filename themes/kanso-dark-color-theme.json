    "tab.activeBorderTop": "#7fb4ca",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#191c22",
    "tab.inactiveForeground": "#75797f",
    "tab.border": "#303338",
    "tab.hoverBackground": "#202329",
    "tab.hoverForeground": "#c5c9c7",
    "tab.unfocusedActiveForeground": "#7fb4ca",
