    "editorGroup.border": "#303338",
    "editorGroup.dropBackground": "#7fb4ca80",

    "breadcrumb.background": "#14171d",
    "breadcrumb.foreground": "#75797f",
    "breadcrumb.focusForeground": "#c5c9c7",
    "breadcrumb.activeSelectionForeground": "#7fb4ca",
    "breadcrumbPicker.background": "#191c22",

    "list.activeSelectionBackground": "#2d3035",
    "list.activeSelectionForeground": "#c5c9c7",
    "list.inactiveSelectionBackground": "#26292e",
    "list.inactiveSelectionForeground": "#c5c9c7",
    "list.hoverBackground": "#202329",
    "list.focusBackground": "#2d3035",
    "list.focusForeground": "#c5c9c7",
    "list.highlightForeground": "#7fb4ca",
    "list.errorForeground": "#c4746e",
    "list.warningForeground": "#c4b28a",
    "list.dropBackground": "#7fb4ca80",
    "listFilterWidget.background": "#191c22",
    "listFilterWidget.outline": "#7fb4ca",

    "input.background": "#1d2026",
    "input.foreground": "#c5c9c7",
    "input.border": "#303338",
    "input.placeholderForeground": "#494c50",
    "inputOption.activeBorder": "#7fb4ca",
    "inputOption.activeForeground": "#c5c9c7",
    "inputValidation.errorBackground": "#c4746e1a",
    "inputValidation.errorBorder": "#c4746e",
    "inputValidation.warningBackground": "#c4b28a1a",
    "inputValidation.warningBorder": "#c4b28a",
    "inputValidation.infoBackground": "#8ba4b01a",
    "inputValidation.infoBorder": "#8ba4b0",

    "dropdown.background": "#191c22",
    "dropdown.foreground": "#c5c9c7",
    "dropdown.border": "#303338",

    "button.background": "#7fb4ca",
    "button.foreground": "#14171d",
    "button.hoverBackground": "#93c1d3",
    "button.secondaryBackground": "#2d3035",
    "button.secondaryForeground": "#c5c9c7",
    "button.secondaryHoverBackground": "#373b3f",
    "button.border": "#303338",

    "badge.background": "#7fb4ca",
    "badge.foreground": "#14171d",

    "progressBar.background": "#7fb4ca",

    "scrollbar.shadow": "#00000055",
    "scrollbarSlider.background": "#46494d70",
    "scrollbarSlider.hoverBackground": "#5b5e6190",
    "scrollbarSlider.activeBackground": "#5b5e61cc",

    "panel.background": "#191c22",
    "panel.border": "#303338",
    "panelTitle.activeBorder": "#7fb4ca",
    "panelTitle.activeForeground": "#c5c9c7",
    "panelTitle.inactiveForeground": "#75797f",
    "panel.dropBorder": "#7fb4ca66",

    "terminal.background": "#14171d",
    "terminal.foreground": "#c5c9c7",
    "terminalCursor.foreground": "#7fb4ca",
    "terminal.selectionBackground": "#2d3035",
    "terminal.ansiBlack": "#14171d",
    "terminal.ansiRed": "#c4746e",
    "terminal.ansiGreen": "#8a9a7b",
    "terminal.ansiYellow": "#c4b28a",
    "terminal.ansiBlue": "#8ba4b0",
    "terminal.ansiMagenta": "#a292a3",
    "terminal.ansiCyan": "#c5c9c7",
    "terminal.ansiWhite": "#a4a7a4",
    "terminal.ansiBrightBlack": "#909398",
    "terminal.ansiBrightRed": "#e46876",
    "terminal.ansiBrightGreen": "#87a987",
    "terminal.ansiBrightYellow": "#e6c384",
    "terminal.ansiBrightBlue": "#7fb4ca",
    "terminal.ansiBrightMagenta": "#938aa9",
    "terminal.ansiBrightCyan": "#7aa89f",
    "terminal.ansiBrightWhite": "#c5c9c7",

    "gitDecoration.addedResourceForeground": "#8a9a7b",
    "gitDecoration.modifiedResourceForeground": "#c4b28a",
    "gitDecoration.deletedResourceForeground": "#c4746e",
    "gitDecoration.renamedResourceForeground": "#938aa9",
    "gitDecoration.untrackedResourceForeground": "#75797f",
    "gitDecoration.ignoredResourceForeground": "#494c50",
    "gitDecoration.conflictingResourceForeground": "#dca561",

    "notifications.background": "#191c22",
    "notifications.foreground": "#c5c9c7",
    "notifications.border": "#303338",
    "notificationCenterHeader.background": "#1d2026",
    "notificationsErrorIcon.foreground": "#c4746e",
    "notificationsWarningIcon.foreground": "#c4b28a",
    "notificationsInfoIcon.foreground": "#8ba4b0",

    "quickInput.background": "#191c22",
    "quickInput.foreground": "#c5c9c7",
    "quickInputList.focusBackground": "#2d3035",
    "quickInputList.focusForeground": "#c5c9c7",

    "pickerGroup.border": "#303338",
    "pickerGroup.foreground": "#7fb4ca",

    "minimap.background": "#14171d",
    "minimap.selectionHighlight": "#2d3035",
    "minimap.findMatchHighlight": "#c4b28a",

    "editorGroupHeader.border": "#303338"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#8992a7",
    "variable.readonly": "#c4b28a",
    "parameter": "#8992a7",
    "property": "#8ba4b0",
    "property.readonly": "#8ba4b0",
    "function": "#8ba4b0",
    "method": "#8ba4b0",
    "class": "#8ea4a2",
    "struct": "#8ea4a2",
    "interface": "#8ea4a2",
    "enum": "#8ea4a2",
    "enumMember": "#8ea4a2",
    "type": "#8ea4a2",
    "typeParameter": "#8ea4a2",
    "namespace": "#8ea4a2",
    "keyword": { "foreground": "#8992a7", "italic": true },
    "modifier": { "foreground": "#8992a7", "italic": true },
    "comment": { "foreground": "#75797f", "italic": true },
    "string": "#8a9a7b",
    "number": "#a292a3",
    "regexp": "#c4b28a",
    "operator": "#909398",
    "decorator": "#8ba4b0",
    "macro": "#c4b28a",
    "label": "#8ea4a2"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#75797f", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "scope": ["string.escape", "constant.character.escape", "punctuation.definition.escape", "character.special"],
      "settings": { "foreground": "#7aa89f" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["string.special", "text.literal"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "scope": ["string.special.symbol", "constant.other.symbol"],
      "settings": { "foreground": "#b6927b" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#a292a3" }
    },
    {
      "scope": ["constant.language.boolean", "constant.language", "support.constant", "constant"],
      "settings": { "foreground": "#b6927b" }
    },
    {
      "scope": ["constant.language.boolean.true", "constant.language.boolean.false"],
      "settings": { "foreground": "#b6927b", "fontStyle": "bold" }
    },
    {
      "scope": ["constant.character"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#8992a7", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": { "foreground": "#909398" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite", "meta.function.parameters"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "meta.object-literal.key", "support.variable.property"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.special"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "scope": ["entity.name.function.macro", "support.function.macro", "meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "meta.type", "entity.name.enum", "entity.name.namespace"],
      "settings": { "foreground": "#8ea4a2" }
    },
    {
      "scope": ["support.type.builtin", "support.class.builtin", "storage.type.builtin"],
      "settings": { "foreground": "#c4b28a", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#8ea4a2" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id", "meta.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "scope": ["entity.name.section", "markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#8ba4b0", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#8ea4a2" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#909398" }
    },
    {
      "scope": ["punctuation.special"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["punctuation.list_marker", "punctuation.definition.list"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8a9a7b", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#c4746e" }
    },
    {
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7aa89f", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.header.from-file"],
      "settings": { "foreground": "#8ea4a2" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c4746e" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "scope": ["meta.brackets", "meta.embedded"],
      "settings": { "foreground": "#c5c9c7" }
    }
  ]
}
