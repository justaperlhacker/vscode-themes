    "list.inactiveSelectionForeground": "#b8b4ad",
    "list.hoverBackground": "#2c4249",
    "list.focusBackground": "#2c4249",
    "list.focusForeground": "#d8d4cd",
    "list.highlightForeground": "#b3daf9",
    "list.errorForeground": "#fac5c7",
    "list.warningForeground": "#d9d8aa",
    "list.dropBackground": "#b3daf980",
    "listFilterWidget.background": "#051a20",
    "listFilterWidget.outline": "#b3daf9",

    "input.background": "#051a20",
    "input.foreground": "#d8d4cd",
    "input.border": "#2c4249",
    "input.placeholderForeground": "#98948e99",
    "inputOption.activeBorder": "#b3daf9",
    "inputOption.activeForeground": "#d8d4cd",
    "inputValidation.errorBackground": "#410d14",
    "inputValidation.errorBorder": "#fac5c7",
    "inputValidation.warningBackground": "#3a3800",
    "inputValidation.warningBorder": "#d9d8aa",
    "inputValidation.infoBackground": "#211a46",
    "inputValidation.infoBorder": "#d1cffb",

    "dropdown.background": "#051a20",
    "dropdown.foreground": "#d8d4cd",
    "dropdown.border": "#2c4249",

    "button.background": "#b3daf9",
    "button.foreground": "#11262d",
    "button.hoverBackground": "#c6e3fa",
    "button.secondaryBackground": "#2c4249",
    "button.secondaryForeground": "#d8d4cd",
    "button.secondaryHoverBackground": "#485f67",
    "button.border": "#2c4249",

    "badge.background": "#b3daf9",
    "badge.foreground": "#11262d",

    "progressBar.background": "#b3daf9",

    "scrollbar.shadow": "#000f1555",
    "scrollbarSlider.background": "#98948e50",
    "scrollbarSlider.hoverBackground": "#b8b4ad80",
    "scrollbarSlider.activeBackground": "#b8b4adcc",

    "panel.background": "#051a20",
    "panel.border": "#2c4249",
    "panelTitle.activeBorder": "#b3daf9",
    "panelTitle.activeForeground": "#d8d4cd",
    "panelTitle.inactiveForeground": "#b8b4ad",
    "panel.dropBorder": "#b3daf966",

    "terminal.background": "#11262d",
    "terminal.foreground": "#d8d4cd",
    "terminalCursor.foreground": "#b3daf9",
    "terminal.selectionBackground": "#38515e",
    "terminal.ansiBlack": "#000f15",
    "terminal.ansiRed": "#fac5c7",
    "terminal.ansiGreen": "#b8e1c1",
    "terminal.ansiYellow": "#d9d8aa",
    "terminal.ansiBlue": "#b3daf9",
    "terminal.ansiMagenta": "#edc7e7",
    "terminal.ansiCyan": "#a6e1e2",
    "terminal.ansiWhite": "#98948e",
    "terminal.ansiBrightBlack": "#485f67",
    "terminal.ansiBrightRed": "#fac5c7",
    "terminal.ansiBrightGreen": "#b8e1c1",
    "terminal.ansiBrightYellow": "#d9d8aa",
    "terminal.ansiBrightBlue": "#b3daf9",
    "terminal.ansiBrightMagenta": "#edc7e7",
    "terminal.ansiBrightCyan": "#a6e1e2",
    "terminal.ansiBrightWhite": "#f4f0e9",

    "gitDecoration.addedResourceForeground": "#b8e1c1",
    "gitDecoration.modifiedResourceForeground": "#d9d8aa",
    "gitDecoration.deletedResourceForeground": "#fac5c7",
    "gitDecoration.renamedResourceForeground": "#edc7e7",
    "gitDecoration.untrackedResourceForeground": "#b8b4ad",
    "gitDecoration.ignoredResourceForeground": "#98948e",
    "gitDecoration.conflictingResourceForeground": "#fac5c7",

    "notifications.background": "#051a20",
    "notifications.foreground": "#d8d4cd",
    "notifications.border": "#2c4249",
    "notificationCenterHeader.background": "#051a20",
    "notificationsErrorIcon.foreground": "#fac5c7",
    "notificationsWarningIcon.foreground": "#d9d8aa",
    "notificationsInfoIcon.foreground": "#d1cffb",

    "quickInput.background": "#051a20",
    "quickInput.foreground": "#d8d4cd",
    "quickInputList.focusBackground": "#2c4249",
    "quickInputList.focusForeground": "#d8d4cd",

    "pickerGroup.border": "#2c4249",
    "pickerGroup.foreground": "#b3daf9",

    "minimap.background": "#11262d",
    "minimap.selectionHighlight": "#38515e",
    "minimap.findMatchHighlight": "#b3daf9",

    "editorGroupHeader.border": "#2c4249"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#d8d4cd",
    "variable.readonly": "#a6e1e2",
    "parameter": "#d8d4cd",
    "property": "#d9d8aa",
    "property.readonly": "#d9d8aa",
    "function": "#b3daf9",
    "method": "#b3daf9",
    "class": "#d8d4cd",
    "struct": "#d8d4cd",
    "interface": "#d8d4cd",
    "enum": "#d8d4cd",
    "enumMember": "#d8d4cd",
    "type": "#d8d4cd",
    "typeParameter": "#d8d4cd",
    "namespace": "#d8d4cd",
    "keyword": { "foreground": "#d8d4cd", "bold": true },
    "modifier": "#d8d4cd",
    "comment": { "foreground": "#98948e", "italic": true },
    "string": "#b8e1c1",
    "number": "#edc7e7",
    "regexp": "#a6e1e2",
    "operator": "#d8d4cd",
    "decorator": "#d1cffb",
    "macro": "#d1cffb",
    "label": "#d8d4cd"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#98948e", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#b8e1c1" }
    },
    {
      "scope": ["string.regexp", "string.other", "string.special", "constant.character.escape", "punctuation.definition.escape"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["constant.other.symbol", "string.special.symbol"],
      "settings": { "foreground": "#edc7e7" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#edc7e7" }
    },
    {
      "scope": ["constant", "constant.language", "constant.character", "support.constant", "constant.language.boolean"],
      "settings": { "foreground": "#edc7e7" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#d8d4cd", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": { "foreground": "#d8d4cd" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#d8d4cd" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite", "meta.function.parameters"],
      "settings": { "foreground": "#d8d4cd" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.special"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#b3daf9" }
    },
    {
      "scope": ["entity.name.function.constructor", "support.function.constructor"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.class", "support.type", "meta.type", "entity.name.enum"],
      "settings": { "foreground": "#d8d4cd" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#d9d8aa" }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name", "support.variable.property"],
      "settings": { "foreground": "#d9d8aa" }
    },
    {
      "scope": ["meta.decorator", "punctuation.definition.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#d1cffb" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#d1cffb" }
    },
    {
      "scope": ["entity.name.section", "markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#b3daf9", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#d8d4cd", "fontStyle": "bold" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#f2ccad" }
    },
    {
      "scope": ["punctuation.special", "punctuation.list_marker", "punctuation.definition.list"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#d9d8aa", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": { "foreground": "#b8e1c1" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#fac5c7" }
    },
    {
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": { "foreground": "#d9d8aa" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#a6e1e2", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw", "text.literal"],
      "settings": { "foreground": "#b8e1c1" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.header.from-file"],
      "settings": { "foreground": "#a6e1e2" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#fac5c7" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#d9d8aa" }
    },
    {
      "scope": ["meta.brackets", "meta.embedded"],
      "settings": { "foreground": "#d8d4cd" }
    }
  ]
}
