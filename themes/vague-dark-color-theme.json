  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#cdcdcd",
    "variable.readonly": "#b4d4cf",
    "parameter": "#bb9dbd",
    "property": "#c3c3d5",
    "property.readonly": "#c3c3d5",
    "function": "#c48282",
    "method": "#c48282",
    "class": "#9bb4bc",
    "struct": "#9bb4bc",
    "interface": "#9bb4bc",
    "enum": "#9bb4bc",
    "enumMember": "#9bb4bc",
    "type": "#9bb4bc",
    "typeParameter": "#9bb4bc",
    "namespace": "#9bb4bc",
    "keyword": "#6e94b2",
    "modifier": "#6e94b2",
    "comment": {
      "foreground": "#606079",
      "italic": true
    },
    "string": "#e8b589",
    "number": "#e0a363",
    "regexp": "#6e94b2",
    "operator": "#90a0b5",
    "decorator": "#6e94b2",
    "macro": "#aeaed1",
    "label": "#6e94b2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606079",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#e8b589",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "punctuation.definition.escape",
        "string.other"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "string.special",
        "string.special.symbol",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#e0a363"
      }
    },
    {
      "scope": [
        "constant.language.boolean",
        "constant.language",
        "constant.character",
        "support.constant",
        "constant"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "constant.language.boolean.true",
        "constant.language.boolean.false"
      ],
      "settings": {
        "foreground": "#e0a363",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
      ],
      "settings": {
        "foreground": "#90a0b5"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.readwrite",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#bb9dbd"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9bb4bc"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.special"
      ],
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "scope": [
        "meta.function-call.method",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#bb9dbd"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "meta.type",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#9bb4bc"
      }
    },
    {
      "scope": [
        "support.type.builtin",
        "support.class.builtin"
      ],
      "settings": {
        "foreground": "#b4d4cf",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#9bb4bc"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#6e94b2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "scope": [
        "punctuation.special",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "punctuation.list_marker"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e8b589",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#7fa563"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#d8647e"
      }
    },
    {
      "scope": [
        "markup.changed",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#f3be7c"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#aeaed1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d8647e"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f3be7c"
      }
    },
    {
      "scope": [
        "meta.brackets",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    }
  ]
}
