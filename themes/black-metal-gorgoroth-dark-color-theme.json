    "statusBar.debuggingBackground": "#888888",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.remoteBackground": "#5f8787",
    "statusBarItem.remoteForeground": "#000000",
    "statusBarItem.hoverBackground": "#1b1b1b",

    "titleBar.activeBackground": "#0a0a0a",
    "titleBar.activeForeground": "#c1c1c1",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#505050",
    "titleBar.border": "#1f1f1f",

    "menu.background": "#060606",
    "menu.foreground": "#c1c1c1",
    "menu.selectionBackground": "#1b1b1b",
    "menu.selectionForeground": "#c1c1c1",
    "menu.border": "#1f1f1f",
    "menu.separatorBackground": "#1f1f1f",

    "tab.activeBackground": "#0e0e0e",
    "tab.activeForeground": "#5f8787",
    "tab.activeBorderTop": "#5f8787",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#060606",
    "tab.inactiveForeground": "#505050",
    "tab.border": "#1f1f1f",
    "tab.hoverBackground": "#0e0e0e",
    "tab.hoverForeground": "#c1c1c1",
    "tab.unfocusedActiveForeground": "#5f8787",
    "tab.unfocusedInactiveForeground": "#505050",

    "editorGroupHeader.tabsBackground": "#060606",
    "editorGroupHeader.tabsBorder": "#1f1f1f",
    "editorGroupHeader.noTabsBackground": "#060606",
    "editorGroup.border": "#1f1f1f",
    "editorGroup.dropBackground": "#5f878780",

    "breadcrumb.background": "#000000",
    "breadcrumb.foreground": "#505050",
    "breadcrumb.focusForeground": "#c1c1c1",
    "breadcrumb.activeSelectionForeground": "#5f8787",
    "breadcrumbPicker.background": "#060606",

    "list.activeSelectionBackground": "#1b1b1b",
    "list.activeSelectionForeground": "#c1c1c1",
    "list.inactiveSelectionBackground": "#131313",
    "list.inactiveSelectionForeground": "#c1c1c1",
    "list.hoverBackground": "#0e0e0e",
    "list.focusBackground": "#1b1b1b",
    "list.focusForeground": "#c1c1c1",
    "list.highlightForeground": "#5f8787",
    "list.errorForeground": "#5f8787",
    "list.warningForeground": "#888888",
    "list.dropBackground": "#5f878780",
    "listFilterWidget.background": "#060606",
    "listFilterWidget.outline": "#5f8787",

    "input.background": "#0a0a0a",
    "input.foreground": "#c1c1c1",
    "input.border": "#1f1f1f",
    "input.placeholderForeground": "#3a3a3a",
    "inputOption.activeBorder": "#5f8787",
    "inputOption.activeForeground": "#c1c1c1",
    "inputValidation.errorBackground": "#5f87871a",
    "inputValidation.errorBorder": "#5f8787",
    "inputValidation.warningBackground": "#8888881a",
    "inputValidation.warningBorder": "#888888",
    "inputValidation.infoBackground": "#aaaaaa1a",
    "inputValidation.infoBorder": "#aaaaaa",

    "dropdown.background": "#060606",
    "dropdown.foreground": "#c1c1c1",
    "dropdown.border": "#1f1f1f",

    "button.background": "#5f8787",
    "button.foreground": "#000000",
    "button.hoverBackground": "#709595",
    "button.secondaryBackground": "#1b1b1b",
    "button.secondaryForeground": "#c1c1c1",
    "button.secondaryHoverBackground": "#272727",
    "button.border": "#1f1f1f",

    "badge.background": "#5f8787",
    "badge.foreground": "#000000",

    "progressBar.background": "#5f8787",

    "scrollbar.shadow": "#00000055",
    "scrollbarSlider.background": "#36363670",
    "scrollbarSlider.hoverBackground": "#4d4d4d90",
    "scrollbarSlider.activeBackground": "#4d4d4dcc",

    "panel.background": "#060606",
    "panel.border": "#1f1f1f",
    "panelTitle.activeBorder": "#5f8787",
    "panelTitle.activeForeground": "#c1c1c1",
    "panelTitle.inactiveForeground": "#505050",
    "panel.dropBorder": "#5f878766",

    "terminal.background": "#000000",
    "terminal.foreground": "#c1c1c1",
    "terminalCursor.foreground": "#5f8787",
    "terminal.selectionBackground": "#1b1b1b",
    "terminal.ansiBlack": "#2a2325",
    "terminal.ansiRed": "#5f8787",
    "terminal.ansiGreen": "#c1c1c1",
    "terminal.ansiYellow": "#888888",
    "terminal.ansiBlue": "#aaaaaa",
    "terminal.ansiMagenta": "#9b8d7f",
    "terminal.ansiCyan": "#ddeecc",
    "terminal.ansiWhite": "#c1c1c1",
    "terminal.ansiBrightBlack": "#505050",
    "terminal.ansiBrightRed": "#5f8787",
    "terminal.ansiBrightGreen": "#c1c1c1",
    "terminal.ansiBrightYellow": "#888888",
    "terminal.ansiBrightBlue": "#aaaaaa",
    "terminal.ansiBrightMagenta": "#999999",
    "terminal.ansiBrightCyan": "#ddeecc",
    "terminal.ansiBrightWhite": "#c1c1c1",

    "gitDecoration.addedResourceForeground": "#6e4c4c",
    "gitDecoration.modifiedResourceForeground": "#888888",
    "gitDecoration.deletedResourceForeground": "#5f8787",
    "gitDecoration.renamedResourceForeground": "#ddeecc",
    "gitDecoration.untrackedResourceForeground": "#505050",
    "gitDecoration.ignoredResourceForeground": "#3a3a3a",
    "gitDecoration.conflictingResourceForeground": "#aaaaaa",

    "notifications.background": "#060606",
    "notifications.foreground": "#c1c1c1",
    "notifications.border": "#1f1f1f",
    "notificationCenterHeader.background": "#0a0a0a",
    "notificationsErrorIcon.foreground": "#5f8787",
    "notificationsWarningIcon.foreground": "#888888",
    "notificationsInfoIcon.foreground": "#aaaaaa",

    "quickInput.background": "#060606",
    "quickInput.foreground": "#c1c1c1",
    "quickInputList.focusBackground": "#1b1b1b",
    "quickInputList.focusForeground": "#c1c1c1",

    "pickerGroup.border": "#1f1f1f",
    "pickerGroup.foreground": "#5f8787",

    "minimap.background": "#000000",
    "minimap.selectionHighlight": "#1b1b1b",
    "minimap.findMatchHighlight": "#888888",

    "editorGroupHeader.border": "#1f1f1f"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#c1c1c1",
    "variable.readonly": "#9b8d7f",
    "parameter": "#c1c1c1",
    "property": "#c1c1c1",
    "property.readonly": "#c1c1c1",
    "function": "#888888",
    "method": "#888888",
    "class": "#9b8d7f",
    "struct": "#9b8d7f",
    "interface": "#9b8d7f",
    "enum": "#9b8d7f",
    "enumMember": "#9b8d7f",
    "type": "#9b8d7f",
    "typeParameter": "#9b8d7f",
    "namespace": "#9b8d7f",
    "keyword": "#999999",
    "modifier": "#999999",
    "comment": "#505050",
    "string": "#ddeecc",
    "number": "#aaaaaa",
    "regexp": "#999999",
    "operator": "#9b99a3",
    "decorator": "#888888",
    "macro": "#9b8d7f",
    "label": "#999999"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#505050", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#ddeecc" }
    },
    {
      "scope": ["string.regexp", "string.escape", "constant.character.escape", "punctuation.definition.escape", "character.special"],
      "settings": { "foreground": "#999999" }
    },
    {
      "scope": ["string.special", "text.literal"],
      "settings": { "foreground": "#ddeecc" }
    },
    {
      "scope": ["string.special.symbol", "constant.other.symbol"],
      "settings": { "foreground": "#aaaaaa" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#aaaaaa" }
    },
    {
      "scope": ["constant.language.boolean", "constant.language", "support.constant", "constant"],
      "settings": { "foreground": "#aaaaaa" }
    },
    {
      "scope": ["constant.language.boolean.true", "constant.language.boolean.false"],
      "settings": { "foreground": "#aaaaaa", "fontStyle": "bold" }
    },
    {
      "scope": ["constant.character"],
      "settings": { "foreground": "#ddeecc" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#999999" }
    },
    {
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": { "foreground": "#9b99a3" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#c1c1c1" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite", "meta.function.parameters"],
      "settings": { "foreground": "#c1c1c1" }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "meta.object-literal.key", "support.variable.property"],
      "settings": { "foreground": "#c1c1c1" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.special"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": ["entity.name.function.macro", "support.function.macro"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "meta.type", "entity.name.enum", "entity.name.namespace"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["support.type.builtin", "support.class.builtin", "storage.type.builtin"],
      "settings": { "foreground": "#9b8d7f", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id", "meta.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#ddeecc" }
    },
    {
      "scope": ["entity.name.section", "markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#999999", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#999999" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#c1c1c1" }
    },
    {
      "scope": ["punctuation.special"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["punctuation.list_marker", "punctuation.definition.list"],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#ddeecc", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": { "foreground": "#6e4c4c" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#5f8787" }
    },
    {
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#9b8d7f", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#ddeecc" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.header.from-file"],
      "settings": { "foreground": "#9b8d7f" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#5f8787" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": ["meta.brackets", "meta.embedded"],
      "settings": { "foreground": "#c1c1c1" }
    }
  ]
}
