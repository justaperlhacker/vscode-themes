  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#d2d5db",
    "variable.readonly": "#94e5ea",
    "property": "#d8da9d",
    "function": "#a9d8ff",
    "class": "#d2d5db",
    "struct": "#d2d5db",
    "interface": "#d2d5db",
    "enum": "#d2d5db",
    "enumMember": "#d2d5db",
    "type": "#d2d5db",
    "typeParameter": "#d2d5db",
    "keyword": {
      "foreground": "#d2d5db",
      "bold": true
    },
    "modifier": {
      "foreground": "#d2d5db",
      "bold": true
    },
    "comment": {
      "foreground": "#92959b",
      "italic": true
    },
    "string": "#abe5be",
    "number": "#f7c2ea",
    "regexp": "#94e5ea",
    "operator": "#d2d5db",
    "decorator": "#d3ccff",
    "label": {
      "foreground": "#d2d5db",
      "bold": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#92959b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#92959b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#abe5be"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "string.special.symbol"
      ],
      "settings": {
        "foreground": "#f7c2ea"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#abe5be"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f7c2ea"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#f7c2ea"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f7c2ea"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#d8da9d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#a9d8ff"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d2d5db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#d2d5db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#bee2ad",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "support.class"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "entity.name.enum",
        "support.type.enum"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "entity.name.enum.variant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d3ccff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#d8da9d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#facb9e"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#facb9e"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#facb9e"
      }
    },
    {
      "scope": [
        "punctuation.special"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "punctuation.list_marker",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#94e5ea"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#d8da9d"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d2d5db",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d2d5db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#d2d5db"
      }
    }
  ]
}
