  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#899ab4",
    "variable.readonly": "#d6b67f",
    "property": "#899ab4",
    "function": "#ab8252",
    "class": "#d87d5f",
    "struct": "#d87d5f",
    "interface": "#d87d5f",
    "enum": "#d87d5f",
    "enumMember": "#d87d5f",
    "type": "#d87d5f",
    "typeParameter": "#d87d5f",
    "keyword": "#d6b67f",
    "modifier": "#d6b67f",
    "comment": {
      "foreground": "#726d73",
      "italic": true
    },
    "string": "#9fac7f",
    "number": "#9fac7f",
    "regexp": "#ac98ac",
    "operator": "#f9f9f9",
    "decorator": "#899ab4",
    "label": "#d6b67f"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#726d73",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#726d73",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9fac7f"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#ac98ac"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ac98ac"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#ac98ac"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "string.special.symbol"
      ],
      "settings": {
        "foreground": "#d08356"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#9fac7f"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9fac7f"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9fac7f"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d08356"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#d6b67f"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#ab8252"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d6b67f"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#d6b67f"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#ab8252"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "support.class"
      ],
      "settings": {
        "foreground": "#d87d5f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#d87d5f"
      }
    },
    {
      "scope": [
        "entity.name.enum",
        "support.type.enum"
      ],
      "settings": {
        "foreground": "#d87d5f"
      }
    },
    {
      "scope": [
        "entity.name.enum.variant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d87d5f"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#d6b67f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#ac98ac"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "punctuation.special"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "punctuation.list_marker",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d6b67f"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ac98ac",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#dad085",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#f9f9f9"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#899ab4"
      }
    }
  ]
}
